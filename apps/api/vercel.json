{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm -r --filter '@take/api...' build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
