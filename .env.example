# API
NODE_ENV=development
ENABLE_DEV_FIXTURES=false
VITE_ENABLE_DEV_FIXTURES=false
PORT=3000
VITE_PRIVY_APP_ID=your-privy-app-id
VITE_MONAD_TESTNET_RPC_URL=https://your-monad-testnet-rpc.example
VITE_API_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://take:take@localhost:5432/take

# Privy
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
INTERNAL_API_TOKEN=

# Optional evidence providers
X_API_BEARER_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_INSTALL_REDIRECT_URI=http://localhost:3000/integrations/discord/callback
DISCORD_INSTALL_STATE_SECRET=

# Monad / QuickNode
MONAD_NETWORK=testnet
MONAD_TESTNET_RPC_URL=
MONAD_TESTNET_WS_URL=
MONAD_MAINNET_RPC_URL=
TAKE_CAMPAIGN_MANAGER_ADDRESS=
TAKE_CAMPAIGN_MANAGER_START_BLOCK=0
CHAIN_INDEXER_CONFIRMATIONS=2
CHAIN_INDEXER_MAX_BLOCK_RANGE=1000
CHAIN_INDEXER_REORG_LOOKBACK=128
EVIDENCE_COLLECTION_CONCURRENCY=5
DRAND_RELAY_URLS=https://api.drand.sh,https://api2.drand.sh,https://drand.cloudflare.com
DRAND_REQUEST_TIMEOUT_MS=8000
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
